{
  "name": "@tweakpad/devkit",
  "version": "0.0.1",
  "description": "High-performance tweak panel for tuning live values, built on @tweakpad/ui inline controls.",
  "license": "MIT",
  "author": "Tweakpad",
  "homepage": "https://github.com/tweakpad/devkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tweakpad/devkit.git"
  },
  "bugs": {
    "url": "https://github.com/tweakpad/devkit/issues"
  },
  "keywords": [
    "tweak",
    "tweakpane",
    "gui",
    "controls",
    "devtools",
    "debug",
    "performance",
    "web-components",
    "lit"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./docs.json": "./dist/docs.json"
  },
  "files": [
    "dist",
    "docs/**/*.mdx"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && npm run docs:build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"demo/**/*.{ts,html}\" \"stories/**/*.ts\" \".storybook/**/*.{ts,mdx,css}\" \"scripts/**/*.mjs\" \"*.{js,ts,json,html,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"demo/**/*.{ts,html}\" \"stories/**/*.ts\" \".storybook/**/*.{ts,mdx,css}\" \"scripts/**/*.mjs\" \"*.{js,ts,json,html,md}\"",
    "lint": "npm run format:check && npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint .",
    "lint:css": "stylelint \"src/**/*.ts\" \".storybook/**/*.css\"",
    "test:package": "npm run build && node scripts/pack-smoke.mjs",
    "changeset": "changeset",
    "release": "changeset publish",
    "docs:build": "node scripts/docs/build.mjs",
    "storybook": "npm run docs:build && storybook dev -p 6007",
    "build-storybook": "npm run docs:build && storybook build"
  },
  "dependencies": {
    "@tweakpad/ui": "^0.4.0"
  },
  "peerDependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.7",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "globals": "^16.4.0",
    "lit": "^3.3.3",
    "postcss-lit": "^1.4.1",
    "prettier": "^3.9.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.7",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
